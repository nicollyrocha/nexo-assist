# Copie para .env.local (apps/web e apps/tickets) e preencha. Em produção, configure na Vercel.
# Nunca commite valores reais. Nada de segredo em variáveis NEXT_PUBLIC_*.

# --- apps/web ---
ANTHROPIC_API_KEY=
# Neon, banco da aplicação: pooled em runtime, direta para migrações
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SESSION_SECRET=
TICKETS_SERVICE_URL=http://localhost:3001
TICKETS_SERVICE_KEY=

# --- apps/tickets ---
TICKETS_DATABASE_URL=
TICKETS_DATABASE_URL_UNPOOLED=
TICKETS_SERVICE_KEY=
# Simulação do legado instável (0 desliga)
TICKETS_FAILURE_RATE=0.1
TICKETS_OUTAGE_MS=3000
