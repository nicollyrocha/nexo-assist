# Modelo das variáveis. Para criar os .env.local dos dois apps com segredos gerados: pnpm setup:env
# Nunca commite valores reais. Nada de segredo em variáveis NEXT_PUBLIC_*.

# --- apps/web ---
# LLM do agent (Mastra, formato provedor/modelo). Padrão gratuito: Gemini (aistudio.google.com).
# Alternativas: groq/openai/gpt-oss-120b (GROQ_API_KEY), openrouter/<modelo>:free (OPENROUTER_API_KEY),
# ollama/qwen3:8b + AGENT_MODEL_URL=http://localhost:11434/v1 (local, sem chave).
AGENT_MODEL=google/gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_MODEL_URL=
# Neon, banco da aplicação: pooled em runtime, direta para migrações
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SESSION_SECRET=
TICKETS_SERVICE_URL=http://localhost:3001
TICKETS_SERVICE_KEY=

# --- apps/tickets ---
TICKETS_DATABASE_URL=
TICKETS_DATABASE_URL_UNPOOLED=
TICKETS_SERVICE_KEY=
# Simulação do legado instável (0 desliga)
TICKETS_FAILURE_RATE=0.1
TICKETS_OUTAGE_MS=3000
