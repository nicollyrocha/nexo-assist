{
  "name": "@nexo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/migrate.ts",
    "db:check": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/check.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@nexo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "tsx": "^4.23.15"
  }
}
