{
  "name": "@nexo/tickets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/check.mts"
  },
  "dependencies": {
    "next": "16.4.3",
    "@nexo/shared": "workspace:*",
    "zod": "^4.6.7",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.9.3",
    "@electric-sql/pglite": "^0.5.14",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.12",
    "tsx": "^4.23.15"
  }
}
