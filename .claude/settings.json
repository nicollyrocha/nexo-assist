{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * eval:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * build:*)",
      "Bash(pnpm --filter * db:generate:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(vercel:*)",
      "Bash(pnpm --filter * db:migrate:*)",
      "Bash(pnpm --filter * db:seed:*)",
      "Bash(pnpm --filter * db:push:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)"
    ]
  }
}
